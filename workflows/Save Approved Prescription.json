    {
      "parameters": {
        "jsCode": "\nconst item = $input.all()[0];\nconst body = item.json.body || {};\nconst headers = item.json.headers || {};\n\nconst rawAuth = headers.authorization || headers.Authorization || '';\nconst token = body.token || rawAuth.replace('Bearer ', '') || rawAuth || '';\n// Accept patientId OR email as the patient identifier\nconst patientId = body.patientId || body.email || body.userId || body.patient_id || '';\nconst prescriptionId = body.prescriptionId || body.prescription_id || '';\nconst medications = body.medications || [];\n\nif (!token || token.trim().length < 8) {\n  return [{ json: { requestValid: false, error: 'Authentication required.', code: 'UNAUTHORIZED', httpStatus: 401 } }];\n}\nif (!patientId || patientId.trim().length === 0) {\n  return [{ json: { requestValid: false, error: 'Patient ID or email is required.', code: 'MISSING_PATIENT_ID', httpStatus: 400 } }];\n}\nif (!Array.isArray(medications) || medications.length === 0) {\n  return [{ json: { requestValid: false, error: 'No medications provided.', code: 'MISSING_MEDICATIONS', httpStatus: 400 } }];\n}\n\nconst now = new Date().toISOString();\nconst results = [];\n\nfor (let i = 0; i < medications.length; i++) {\n  const med = medications[i];\n  if (!med || typeof med !== 'object') continue;\n  const name = med.medicineName || med.name || med.medicine_name || med.medication_name || '';\n  if (!name || name.trim().length === 0) {\n    return [{ json: { requestValid: false, error: 'Medicine name missing at index ' + i, code: 'INVALID_MEDICATION_DATA', httpStatus: 400 } }];\n  }\n\n  // Accept scheduledTimes (array), scheduledTime, or time (string from frontend)\n  const rawTimes = med.scheduledTimes || med.scheduledTime || med.time || [];\n  const timesArr = Array.isArray(rawTimes) ? rawTimes : (rawTimes ? [rawTimes] : []);\n\n  // Build duration from startDate/endDate if duration not provided\n  let duration = med.duration || '';\n  if (!duration && med.startDate && med.endDate) {\n    const start = new Date(med.startDate);\n    const end = new Date(med.endDate);\n    const days = Math.round((end - start) / (1000 * 60 * 60 * 24));\n    if (days > 0) duration = days + ' Days';\n  }\n\n  results.push({ json: {\n    requestValid: true,\n    medicine_name: name.trim(),\n    dosage: med.dosage || '',\n    dosage_unit: med.dosageUnit || med.dosage_unit || '',\n    form: med.form || '',\n    frequency: med.frequency || '',\n    scheduled_times: timesArr.filter(Boolean).join(', '),\n    duration: duration,\n    food_instruction: med.foodInstruction || med.food_instruction || '',\n    instructions: med.instructions || '',\n    route: med.route || '',\n    patient_ref: patientId.trim(),\n    prescription_id: prescriptionId || '',\n    status: 'active',\n    saved_at: now,\n    source: 'prescription_scan',\n  }});\n}\n\nif (results.length === 0) {\n  return [{ json: { requestValid: false, error: 'No valid medications after validation.', code: 'INVALID_MEDICATION_DATA', httpStatus: 400 } }];\n}\n\nreturn results;\n"
      },
