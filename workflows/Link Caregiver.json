      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst body = $input.first().json.body || {};\nconst patientId = (body.patientId || '').trim();\nconst caregiverEmail = (body.caregiverEmail || '').trim().toLowerCase();\nconst rawToken = (body.token || '').trim();\n\nif (!patientId || !caregiverEmail || !rawToken) {\n  return [{ json: { valid: false, code: 'INVALID_INPUT', message: 'Patient ID, caregiver email, and token are required.' } }];\n}\n\nconst emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\nif (!emailRegex.test(caregiverEmail)) {\n  return [{ json: { valid: false, code: 'INVALID_INPUT', message: 'A valid caregiver email address is required.' } }];\n}\n\nconst tokenHash = crypto.createHash('sha256').update(rawToken).digest('hex');\nreturn [{ json: { valid: true, patientId, caregiverEmail, tokenHash } }];"
      },
