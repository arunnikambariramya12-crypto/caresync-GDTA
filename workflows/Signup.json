    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst validateNode = $('Validate Input').first().json;\n\nconst password = validateNode.password;\nconst role = validateNode.role;\nconst fullName = validateNode.fullName;\nconst email = validateNode.email;\nconst phone = validateNode.phone;\n\nconst salt = crypto.randomBytes(16).toString('hex');\nconst hash = crypto.pbkdf2Sync(password, salt, 10000, 64, 'sha512').toString('hex');\nconst passwordHash = salt + ':' + hash;\n\nconst timestamp = Date.now();\nconst randomSuffix = crypto.randomBytes(4).toString('hex');\nconst userRef = role + '_' + timestamp + '_' + randomSuffix;\n\nconst now = new Date().toISOString();\n\nreturn [{\n  json: {\n    full_name: fullName,\n    email: email,\n    phone: phone,\n    password_hash: passwordHash,\n    role: role,\n    user_ref: userRef,\n    is_active: true,\n    last_login: '',\n    pin_hash: '',\n    created_date: now,\n    updated_date: now,\n  }\n}];"
      },
