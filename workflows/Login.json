    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\n\nconst userRow = $('Lookup User').first().json;\nconst inputPassword = $('Validate Input').first().json.password;\n\nconst storedHash = userRow.password_hash || '';\nconst [salt, hash] = storedHash.split(':');\n\nlet passwordMatch = false;\nif (salt && hash) {\n  const derived = crypto.pbkdf2Sync(inputPassword, salt, 10000, 64, 'sha512').toString('hex');\n  passwordMatch = derived === hash;\n}\n\nif (!passwordMatch) {\n  return [{ json: { valid: false } }];\n}\n\n// Generate a session token\nconst rawToken = crypto.randomBytes(32).toString('hex');\nconst tokenHash = crypto.createHash('sha256').update(rawToken).digest('hex');\nconst now = new Date().toISOString();\nconst expiresAt = new Date(Date.now() + 24 * 60 * 60 * 1000).toISOString(); // 24 hours\n\nreturn [{\n  json: {\n    valid: true,\n    rawToken,\n    tokenHash,\n    now,\n    expiresAt,\n    email: userRow.email,\n    full_name: userRow.full_name,\n    role: userRow.role,\n    user_ref: userRow.user_ref,\n  }\n}];"
      },
