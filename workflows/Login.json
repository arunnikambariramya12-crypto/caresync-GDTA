    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || {};\nconst email = (body.email || '').trim().toLowerCase();\nconst password = body.password || '';\n\nif (!email || !password) {\n  return [{ json: { valid: false, code: 'INVALID_INPUT', message: 'Email and password are required.' } }];\n}\n\nconst emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\nif (!emailRegex.test(email)) {\n  return [{ json: { valid: false, code: 'INVALID_INPUT', message: 'A valid email address is required.' } }];\n}\n\nreturn [{ json: { valid: true, email, password } }];"
      },
