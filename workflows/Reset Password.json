    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst validateResetNode = $('Validate Reset Token').first().json;\nconst inputNode = $('Validate Input').first().json;\n\nconst email = validateResetNode.email;\nconst newPassword = inputNode.newPassword;\nconst tokenHash = validateResetNode.tokenHash;\n\nconst salt = crypto.randomBytes(16).toString('hex');\nconst hash = crypto.pbkdf2Sync(newPassword, salt, 10000, 64, 'sha512').toString('hex');\nconst passwordHash = salt + ':' + hash;\n\nconst now = new Date().toISOString();\n\nreturn [{ json: { email, passwordHash, tokenHash, now } }];"
      },
