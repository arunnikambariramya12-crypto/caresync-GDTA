    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst body = $input.first().json.body || {};\nconst rawToken = (body.token || '').trim();\n\nif (!rawToken) {\n  return [{ json: { valid: false, code: 'INVALID_INPUT', message: 'Token is required.' } }];\n}\n\nconst tokenHash = crypto.createHash('sha256').update(rawToken).digest('hex');\nreturn [{ json: { valid: true, tokenHash } }];"
      },
      "id": "75bfc198-2c16-46bb-9d1f-328bc90cda19",
      "name": "Validate & Hash Token",
