      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\n\n// Check if user was found (alwaysOutputData gives {} when empty)\nconst users = $('Lookup User').all();\nconst hasUser = users.length > 0 && Object.keys(users[0].json).length > 0 && !!users[0].json.email;\n\n// Get email from the validation step\nconst email = $('Validate Email Input').first().json.email;\n\nif (!hasUser) {\n  return [{ json: { hasUser: false, email } }];\n}\n\n// Generate a 6-digit unique reset code\nconst rawToken = Math.floor(100000 + Math.random() * 900000).toString();\nconst tokenHash = crypto.createHash('sha256').update(rawToken).digest('hex');\n\nconst now = new Date();\nconst expiresAt = new Date(now.getTime() + 60 * 60 * 1000).toISOString(); // valid 1 hour\n\nreturn [{ json: { hasUser: true, email, rawToken, tokenHash, expiresAt, now: now.toISOString() } }];"
      },
      "id": "0147b875-35a0-4946-b723-6fa1f83a75d6",
