    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || {};\nconst email = (body.email || '').trim().toLowerCase();\n\nif (!email) {\n  return [{ json: { valid: false, code: 'INVALID_INPUT', message: 'Email is required.' } }];\n}\n\nconst emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\nif (!emailRegex.test(email)) {\n  return [{ json: { valid: false, code: 'INVALID_INPUT', message: 'A valid email address is required.' } }];\n}\n\nreturn [{ json: { valid: true, email } }];"
      },
      "id": "0fc48e1b-4603-4d6b-9e36-87caca93ac1c",
      "name": "Validate Email Input",
      "type": "n8n-nodes-base.code",
