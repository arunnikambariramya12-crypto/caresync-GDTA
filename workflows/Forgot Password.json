        },
        "filters": {
          "conditions": [
            {
              "keyName": "email",
              "keyValue": "={{ $json.email }}"
            }
          ]
        },
        "limit": 1
      },
      "id": "5908d024-dfe5-4f58-a026-1b296d191de4",
      "name": "Lookup User",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
